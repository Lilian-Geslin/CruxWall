# Modèle de fichier .env : copie ce fichier en ".env" (à la racine, à côté de run.py) puis remplis les valeurs.
# Le vrai .env ne doit JAMAIS être envoyé sur Git (il est déjà dans .gitignore).

# --- Obligatoire ---------------------------------------------------------------
# Clé qui signe les sessions (16 caractères minimum, 32+ conseillés). Génération :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# --- Sur ton PC uniquement (jamais sur le serveur) -----------------------------
# Désactive le HTTPS forcé et le cookie "secure" pour travailler en http://127.0.0.1:5000
CRUXWALL_ENV=development

# --- Sur le serveur uniquement -------------------------------------------------
# TRUST_PROXY=1            # lit la vraie adresse IP du visiteur (limitation des tentatives)

# --- Pages légales (obligatoires pour un site public) --------------------------
# LEGAL_PUBLISHER_NAME=Prénom Nom
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_CONTACT_EMAIL=contact@exemple.fr
# LEGAL_HOST=PythonAnywhere (https://www.pythonanywhere.com)

# --- Détection automatique des prises (facultatif) -----------------------------
# ROBOFLOW_API_KEY=
# ROBOFLOW_PROJECT=
# ROBOFLOW_VERSION=
# DETECT_DAILY_LIMIT=100   # analyses par 24 h pour tout le site

# --- Autres réglages (facultatifs, valeurs par défaut entre parenthèses) -------
# MAX_UPLOADS_MB=350       # plafond total des photos sur le disque
# FORCE_HTTPS=1            # 0 = pas de redirection http -> https (production)
# AUTO_MAINTENANCE=1       # 0 = pas de sauvegarde/nettoyage automatiques
# BACKUP_DIR=              # dossier des sauvegardes (défaut : backups/)
# CRUXWALL_DATABASE=       # chemin de la base (défaut : cruxwall.db à la racine)
# SQLITE_WAL=0             # 1 = mode WAL (seulement si l'hébergeur le supporte)
